# Docker Compose host publication. Keep loopback until administrator setup is done.
ORDARR_BIND_IP=127.0.0.1
ORDARR_PORT=8080
# Optional published image override (leave unset for the local development build):
# ORDARR_IMAGE=ghcr.io/trentnbauer/ordarr:0.7.0-rc.1
# Enable behind an HTTPS reverse proxy; forwarded headers are not trusted.
ORDARR_SECURE_COOKIES=false
TZ=Etc/UTC
# Native execution only (Compose supplies the container values):
# ORDARR_ADDR=127.0.0.1:8080
# ORDARR_DATA_DIR=./data
